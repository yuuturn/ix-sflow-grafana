# ---------------------------------------------------------------------------
# 設定値のサンプル。コピーして .env を作り、値を書き換えること。
#
#   cp .env.example .env
#   chmod 600 .env
#
# パスワード類はここに書かず、README の手順で生成して追記する。
# ---------------------------------------------------------------------------

# Grafana にブラウザからアクセスする URL（コレクタのアドレスに合わせる）
GRAFANA_ROOT_URL=http://192.0.2.10:3000/
GRAFANA_DOMAIN=192.0.2.10

# Grafana にインストールするプラグイン（カンマ区切り）
# 既定は Sankey に使う Plotly パネル。変更する場合のみ指定する。
# GRAFANA_PLUGINS=ae3e-plotly-panel

# パスワード類（README の手順で生成して追記する）
# PG_ADMIN_PASSWORD=
# PG_PMACCT_PASSWORD=
# PG_GRAFANA_PASSWORD=
# GRAFANA_ADMIN_PASSWORD=
