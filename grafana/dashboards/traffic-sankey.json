      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH base AS (\n  SELECT bucket,\n         CASE WHEN direction = 'inbound' THEN src_asn ELSE dst_asn END AS asn,\n         CASE WHEN direction = 'inbound' THEN src_org ELSE dst_org END AS org,\n         bytes\n  FROM flow_5m\n  WHERE $__timeFilter(bucket)\n    AND ('$direction' IN ('all','すべて') OR direction = '$direction')\n    AND direction IN ('inbound','outbound')\n),\nknown AS (SELECT * FROM base WHERE asn > 0),\ntop8 AS (SELECT asn FROM known GROUP BY 1 ORDER BY sum(bytes) DESC LIMIT 8)\nSELECT k.bucket AS time,\n       'AS' || k.asn || ' ' || min(k.org) AS metric,\n       sum(k.bytes) * 8 / 300.0 AS value\nFROM known k\nJOIN top8 t ON t.asn = k.asn\nGROUP BY k.bucket, k.asn\nORDER BY 1"
        }
      ]
    },
