    {
      "id": 10,
      "type": "ae3e-plotly-panel",
      "title": "Sankey: 送信元 → 宛先(AS) → サービス",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "trafficdb"
      },
      "gridPos": {
        "h": 19,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "options": {
        "title": "",
        "onclick": "",
        "config": {
          "displayModeBar": false,
          "responsive": true
        },
        "layout": {
          "font": {
            "size": 11,
            "color": "#d8d9da"
          },
          "margin": {
            "l": 10,
            "r": 10,
            "t": 10,
            "b": 10
          },
          "paper_bgcolor": "rgba(0,0,0,0)",
          "plot_bgcolor": "rgba(0,0,0,0)"
        },
        "script": "// Rows are (source, target, value) already chained by sankey_flows():\n//   S|<host or AS>  ->  D|<host or AS>  ->  P|<port>\nconst fields = data.series[0].fields;\nconst col = (i) => {\n  const v = fields[i].values;\n  return Array.from(v.buffer ? v.buffer : v);\n};\nconst src = col(0);\nconst tgt = col(1);\nconst val = col(2).map(Number);\n\nconst nodes = Array.from(new Set(src.concat(tgt)));\nconst index = {};\nnodes.forEach((n, i) => { index[n] = i; });\n\nconst shortLabel = (n) => n.replace(/^[SDP]\\|/, '');\nconst nodeColor = (n) => n.charAt(0) === 'S' ? '#5794f2'\n                     : n.charAt(0) === 'D' ? '#f2495c'\n                     : '#ff9830';\n\nconst total = val.reduce((a, b) => a + b, 0) || 1;\n\nreturn {\n  data: [{\n    type: 'sankey',\n    orientation: 'h',\n    arrangement: 'snap',\n    valueformat: '.3s',\n    valuesuffix: ' B',\n    node: {\n      label: nodes.map(shortLabel),\n      color: nodes.map(nodeColor),\n      pad: 22,\n      thickness: 14,\n      line: { color: 'rgba(0,0,0,0.4)', width: 0.5 },\n      hovertemplate: '%{label}<br>%{value:.3s} B<extra></extra>'\n    },\n    link: {\n      source: src.map((s) => index[s]),\n      target: tgt.map((t) => index[t]),\n      value: val,\n      color: 'rgba(140,160,200,0.35)',\n      hovertemplate: '%{source.label} → %{target.label}<br>%{value:.3s} B<extra></extra>'\n    }\n  }],\n  layout: { font: { size: 11, color: '#d8d9da' } },\n  config: { displayModeBar: false, responsive: true }\n};\n"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT source, target, value FROM sankey_flows($__timeFrom()::timestamp, $__timeTo()::timestamp, '$direction', $topn)"
        }
      ]
    },
